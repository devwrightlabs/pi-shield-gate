{
  "name": "@devright/pi-shield-gate",
  "version": "0.1.0",
  "description": "Strictly typed Pi Network security, authentication, anti-bot, and Supabase RLS middleware engine.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsup",
    "dev": "tsup --watch"
  },
  "keywords": [
    "pi-network",
    "security",
    "authentication",
    "supabase",
    "rls",
    "typescript",
    "react"
  ],
  "author": "Devright Labs",
  "license": "MIT",
  "peerDependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsup": "^8.2.4",
    "typescript": "^5.8.3"
  }
}
